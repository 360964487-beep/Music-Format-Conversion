<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频下载 · 轻转" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
  <StackPanel Margin="26">
    <Label Content="视频链接或分享文案" Target="{Binding ElementName=VideoLink}"/>
    <TextBox Name="VideoLink" TextWrapping="Wrap" MaxLength="4096" MinHeight="44"/>
    <DockPanel Margin="0,12,0,0">
      <Button Name="PickVideoCookies" Content="选择抖音 Cookie" DockPanel.Dock="Right" MinHeight="44"/>
      <TextBlock Name="VideoCookieStatus" Text="抖音 Cookie（按需）" VerticalAlignment="Center"
                 Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    </DockPanel>
    <ProgressBar Name="VideoProgress" Height="5" Visibility="Hidden" Margin="0,10,0,0"/>
    <TextBlock Name="VideoStatus" TextWrapping="Wrap" Margin="0,8,0,0"
               AutomationProperties.LiveSetting="Polite"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Name="StartVideo" Content="下载 MP4" Tag="primary" IsDefault="True" MinHeight="44"/>
    </StackPanel>
  </StackPanel>
</Window>
