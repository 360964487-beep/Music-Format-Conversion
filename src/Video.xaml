<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频下载 · 轻转" Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14">
  <StackPanel Margin="26">
    <TextBlock Text="下载视频" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="支持 B 站和抖音单个视频，保存为 MP4。" Margin="0,6,0,16"
               Foreground="{DynamicResource Muted}"/>
    <Label Content="视频链接或分享文案" Target="{Binding ElementName=VideoLink}"/>
    <TextBox Name="VideoLink" TextWrapping="Wrap" MaxLength="4096" MinHeight="44"/>
    <Label Content="保存目录" Target="{Binding ElementName=VideoDestination}" Margin="0,10,0,0"/>
    <DockPanel>
      <Button Name="PickVideoDestination" Content="选择目录" DockPanel.Dock="Right" MinHeight="44"/>
      <TextBox Name="VideoDestination" MinHeight="44"/>
    </DockPanel>
    <DockPanel Margin="0,12,0,0">
      <Button Name="PickVideoCookies" Content="选择抖音 Cookie" DockPanel.Dock="Right" MinHeight="44"/>
      <TextBlock Name="VideoCookieStatus" Text="抖音 Cookie（按需）" VerticalAlignment="Center"
                 Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
    </DockPanel>
    <ProgressBar Name="VideoProgress" Height="5" Visibility="Hidden" Margin="0,10,0,0"/>
    <TextBlock Name="VideoStatus" MinHeight="44" TextWrapping="Wrap" Margin="0,8,0,0"
               AutomationProperties.LiveSetting="Polite" Text="粘贴链接后即可开始。"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Name="OpenVideoDestination" Content="打开保存目录" IsEnabled="False" MinHeight="44"/>
      <Button Name="StartVideo" Content="下载 MP4" Tag="primary" IsDefault="True" MinHeight="44"/>
    </StackPanel>
  </StackPanel>
</Window>
