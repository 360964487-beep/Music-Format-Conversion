<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="目录设置 · 轻转" Width="660" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="14"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,24"><TextBlock Text="从熟悉的目录开始。" FontSize="24" FontWeight="Bold"/><TextBlock Text="设置会保存在工具文件夹中，下次启动自动恢复。" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,0,0,20"><Label Content="默认添加文件目录" Target="{Binding ElementName=DefaultInput}"/><DockPanel><Button Name="PickInput" Content="选择" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Name="DefaultInput"/></DockPanel><TextBlock Text="“添加文件”和“添加文件夹”均从此处打开；留空使用系统音乐目录。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Row="2"><Label Content="默认保存目录" Target="{Binding ElementName=DefaultOutput}"/><DockPanel><Button Name="PickOutput" Content="选择" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox Name="DefaultOutput"/></DockPanel><TextBlock Text="留空时，每首歌曲保存到原目录下的 MP3 文件夹。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Row="3" Name="Validation" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,12,0,0"/><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Name="ResetPaths" Content="恢复默认"/><Button Name="CloseSettings" Content="取消" IsCancel="True"/><Button Name="SaveSettings" Content="保存设置" Tag="primary" IsDefault="True"/></StackPanel></Grid></Window>