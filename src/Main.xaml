<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="轻转 · 音频转换" Width="980" Height="660" MinWidth="840" MinHeight="540"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ComboBox Name="ThemeChoice" Width="142" MinHeight="44" AutomationProperties.Name="外观">
        </ComboBox>
        <Button Name="DownloadVideo" Content="视频下载" MinHeight="44" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock Text="轻转" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Name="Remove" Content="移除所选" IsEnabled="False" MinHeight="44" Margin="0,0,8,0"/>
        <Button Name="Add" Content="添加文件" MinHeight="44" Margin="0"/>
      </StackPanel>
      <TextBlock Name="Count" Text="转换队列 · 0 首" FontSize="16"
                 FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>

    <Grid Grid.Row="2">
      <DataGrid Name="Queue" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{DynamicResource Line}" Background="{DynamicResource Surface}"
                RowBackground="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
                BorderBrush="{DynamicResource Line}" RowHeight="44" ColumnHeaderHeight="36"
                EnableRowVirtualization="True" HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="*" MinWidth="140"/>
          <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="64"/>
          <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="84"/>
          <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="206"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Name="EmptyQueue" Text="拖入文件或点击「添加文件」" IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36,0,0"
                 Foreground="{DynamicResource Muted}"/>
    </Grid>

    <ProgressBar Grid.Row="3" Name="Progress" Maximum="100" Height="4" Margin="0,8,0,0"
                 Visibility="Collapsed" AutomationProperties.Name="转换进度"
                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/>

    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="188"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <Label Content="音质" Target="{Binding ElementName=Quality}"/>
          <ComboBox Name="Quality" MinHeight="44" SelectedIndex="0">
            <ComboBoxItem Content="MP3 · 320 kbps"/>
            <ComboBoxItem Content="MP3 · 256 kbps"/>
            <ComboBoxItem Content="MP3 · 192 kbps"/>
            <ComboBoxItem Content="MP3 · 128 kbps"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Label Content="保存目录" Target="{Binding ElementName=Destination}"/>
          <TextBox Name="Destination" MinHeight="44" Height="44" VerticalContentAlignment="Center"
                   ToolTip="留空时保存到源文件旁的 MP3 文件夹"/>
        </StackPanel>
        <Button Grid.Column="2" Name="Browse" Content="选择目录" MinHeight="44"
                VerticalAlignment="Bottom" Margin="8,0,0,0"/>
      </Grid>
      <DockPanel Margin="0,12,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Name="Open" Content="打开输出" Visibility="Collapsed" MinHeight="44" Margin="0,0,8,0"/>
          <Button Name="Cancel" Content="取消" Visibility="Collapsed" MinHeight="44" Margin="0,0,8,0"/>
          <Button Name="Start" Content="开始转换" Tag="primary" MinHeight="44" MinWidth="138"
                  IsEnabled="False" Margin="0"/>
        </StackPanel>
        <TextBlock Name="Summary" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
