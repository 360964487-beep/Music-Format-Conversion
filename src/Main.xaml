<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="轻转 · 本地音频转换" Width="1100" Height="820" MinWidth="900" MinHeight="760" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True">
<Grid Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="外观" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Name="ThemeChoice" Width="168" SelectedIndex="0"><ComboBoxItem Content="极简亮色"/><ComboBoxItem Content="霓虹夜色"/><ComboBoxItem Content="酸性青柠"/><ComboBoxItem Content="糖果撞色"/></ComboBox><Button Name="Settings" Content="目录设置" Margin="12,0,0,0"/></StackPanel><StackPanel><TextBlock Text="轻转 / QZ" FontSize="26" FontWeight="Bold"/><TextBlock Text="OFFLINE AUDIO CONVERTER" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
<Border Name="HeroPanel" Grid.Row="1" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Hero}" Padding="24,22" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Name="HeroTitle" Text="让音乐，随处可听。" Foreground="{DynamicResource HeroInk}" FontSize="29" FontWeight="Bold"/><TextBlock Text="拖入文件 / 文件夹 · NCM / FLAC → MP3" Foreground="{DynamicResource HeroInk}" Margin="0,9,0,0"/><TextBlock Name="ImportHint" Text="默认添加目录：系统音乐文件夹" Foreground="{DynamicResource HeroInk}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,9,15,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Name="Add" Content="添加文件"/><Button Name="Folder" Content="添加文件夹"/></StackPanel></Grid></Border>
<DockPanel Grid.Row="2" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Name="Match" Content="关联歌词"/><Button Name="Remove" Content="移除所选"/><Button Name="Clear" Content="清空"/></StackPanel><TextBlock Name="Count" Text="转换队列 · 0 首歌曲" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<DataGrid Name="Queue" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" RowHeight="48" ColumnHeaderHeight="38" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="60"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="85"/><DataGridTextColumn Header="歌词" Binding="{Binding LyricState}" Width="120"/><DataGridTextColumn Header="状态 / 错误" Binding="{Binding Status}" Width="210"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="4" Margin="0,12"><TextBlock Text="本地处理 · 保留原文件 · LRC 随歌曲保存，不单独生成音频" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/><ProgressBar Name="Progress" Maximum="100" Height="6" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/></StackPanel>
<StackPanel Grid.Row="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><Label Content="输出音质" Target="{Binding ElementName=Quality}"/><ComboBox Name="Quality" SelectedIndex="0"><ComboBoxItem Content="MP3 · 320 kbps"/><ComboBoxItem Content="MP3 · 256 kbps"/><ComboBoxItem Content="MP3 · 192 kbps"/><ComboBoxItem Content="MP3 · 128 kbps"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><Label Content="默认保存目录（留空：原目录 / MP3）" Target="{Binding ElementName=Destination}"/><TextBox Name="Destination" ToolTip="修改后会记住，下次启动自动恢复"/></StackPanel><Button Grid.Column="2" Name="Browse" Content="浏览" VerticalAlignment="Bottom" Margin="10,0,0,0"/></Grid><DockPanel Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Name="Open" Content="打开输出" IsEnabled="False"/><Button Name="Cancel" Content="取消" IsEnabled="False"/><Button Name="Start" Content="开始转换" Tag="primary" MinWidth="145" IsEnabled="False"/></StackPanel><TextBlock Name="Summary" Text="添加文件后即可开始" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,10,0"/></DockPanel></StackPanel>
</Grid></Window>